generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

/// User Model
model User {
  id                   String                    @id @default(uuid()) @db.Uuid
  name                 String
  email                String                    @unique
  password             String
  phoneNumber          String?                   @unique
  profileImageUrl      String?
  bio                  String?
  gender               Gender?
  dateOfBirth          DateTime?
  homeCity             String
  homeState            String?
  homeCountry          String
  /// PostGIS Geography Point
  currentLocation      Unsupported("geography")?
  trustScore           Float                     @default(100)
  isVerified           Boolean                   @default(false)
  accountStatus        AccountStatus             @default(ACTIVE)
  deletedAt            DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  organizedActivities  Activity[]                @relation("OrganizerActivities")
  sentInvitations      ActivityInvitation[]      @relation("SentInvitations")
  receivedInvitations  ActivityInvitation[]      @relation("UserInvitations")
  approvedParticipants ActivityParticipant[]     @relation("ApprovedParticipants")
  joinedActivities     ActivityParticipant[]
  sports               UserSport[]

  @@index([homeCity])
  @@index([homeCountry])
}

model UserSport {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  activityType ActivityType
  skillLevel   SkillLevel
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityType])
  @@index([userId])
  @@index([activityType])
}

model Activity {
  id                   String                   @id @default(uuid()) @db.Uuid
  title                String
  description          String?
  activityType         ActivityType
  venueName            String
  venueAddress         String?
  /// PostGIS Geography Point
  location             Unsupported("geography")
  startsAt             DateTime
  endsAt               DateTime
  maxParticipants      Int                      @default(2)
  status               ActivityStatus           @default(OPEN)
  minimumSkillLevel    SkillLevel?
  notes                String?
  cancelReason         String?
  isPrivate            Boolean                  @default(false)
  endedAt              DateTime?
  deletedAt            DateTime?
  joinApprovalRequired Boolean                  @default(true)
  organizerId          String                   @db.Uuid
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  organizer            User                     @relation("OrganizerActivities", fields: [organizerId], references: [id], onDelete: Cascade)
  invitations          ActivityInvitation[]
  participants         ActivityParticipant[]

  @@index([activityType, status])
  @@index([startsAt])
  @@index([organizerId])
}

model ActivityParticipant {
  id           String            @id @default(uuid()) @db.Uuid
  activityId   String            @db.Uuid
  userId       String            @db.Uuid
  role         ParticipantRole   @default(PARTICIPANT)
  status       ParticipantStatus @default(PENDING)
  requestedAt  DateTime          @default(now())
  approvedAt   DateTime?
  updatedAt    DateTime          @updatedAt
  approvedById String?           @db.Uuid
  activity     Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  approvedBy   User?             @relation("ApprovedParticipants", fields: [approvedById], references: [id])
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
  @@index([status])
}

model ActivityInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  activityId    String           @db.Uuid
  invitedUserId String           @db.Uuid
  invitedById   String           @db.Uuid
  status        InvitationStatus @default(PENDING)
  message       String?
  expiresAt     DateTime?
  respondedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  activity      Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  invitedBy     User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser   User             @relation("UserInvitations", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@unique([activityId, invitedUserId])
  @@index([activityId])
  @@index([invitedUserId])
  @@index([status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum ActivityType {
  BADMINTON
  CRICKET
  FOOTBALL
  VOLLEYBALL
  TENNIS
  RUNNING
  CYCLING
  TREKKING
  CAB_SHARE
  OTHER
}

enum ActivityStatus {
  OPEN
  FULL
  ONGOING
  COMPLETED
  CANCELLED
}

enum ParticipantRole {
  ORGANIZER
  PARTICIPANT
}

enum ParticipantStatus {
  PENDING
  ACCEPTED
  REJECTED
  LEFT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}
